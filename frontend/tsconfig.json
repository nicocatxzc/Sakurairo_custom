{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "types": ["vite/client"],
        "allowJs": true,
        "checkJs": false,
        "strict": false,
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": [
        "types/**/*",
        "app/**/*",
        "components/**/*",
        "main.js"
    ]
}
