{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "types": ["vite/client"],
        "allowJs": true,
        "checkJs": true,
        "strict": false,
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": [
        "types/**/*",
        "components/**/*.vue",
        "app/**/*.ts",
        "types/*.ts"
    ]
}
